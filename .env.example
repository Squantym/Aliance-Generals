# ===================================================================
# .env.example — скопируйте в .env и заполните перед запуском
# Файл .env НЕЛЬЗЯ публиковать на GitHub (добавьте в .gitignore)!
# ===================================================================

# --- Порт сервера (по умолчанию 3000) ---
# PORT=3000

# --- MongoDB ---
# Строка подключения с MongoDB Atlas (бесплатный тариф M0):
# 1. Зарегистрируйтесь на mongodb.com/cloud/atlas
# 2. Создайте кластер (Free / M0)
# 3. Нажмите «Connect → Drivers», скопируйте строку вида:
#    mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
# 4. Вставьте сюда:
# MONGODB_URI=mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/

# Имя базы данных (по умолчанию generals)
# MONGODB_DB=generals

# --- Отправка писем (подтверждение почты, восстановление пароля) ---
#
# ОСНОВНОЙ СЕРВИС: Unisender Go — российский.
# Это важно: письма с зарубежных серверов mail.ru и Яндекс часто кладут
# в спам, а у нашей аудитории почта в основном там. Игрок не получит
# письмо, не сможет войти и уйдёт, причём молча.
#
# Как подключить:
#   1. Зарегистрируйтесь на go.unisender.ru (бесплатно 1000 писем/мес)
#   2. Добавьте свой домен и подтвердите его: сервис выдаст записи
#      SPF, DKIM и DMARC — пропишите их у регистратора домена.
#      БЕЗ ЭТОГО письма будут падать в спам у любого сервиса.
#   3. Создайте ключ API и вставьте его ниже
#
# UNISENDER_API_KEY=ваш_ключ
#
# Адрес API. Менять нужно, только если аккаунт заведён на европейской
# площадке (go2.unisender.com вместо go1.unisender.ru).
# UNISENDER_URL=https://go1.unisender.ru/ru/transactional/api/v1/email/send.json
#
# Отправитель. Адрес должен быть на подтверждённом домене.
# EMAIL_FROM=Генералы <noreply@alliance-general.ru>
#
# Адрес игры — из него собираются ссылки в письмах
# APP_URL=https://alliance-general.ru
#
# ЗАПАСНОЙ ВАРИАНТ: Resend (США). Работает, если ключа Unisender нет.
# Для игроков с российской почтой доставка хуже.
# RESEND_API_KEY=re_ваш_ключ
#
# Если ни один ключ не задан — режим разработки: письма не отправляются,
# ссылка подтверждения выводится в консоль, почта считается подтверждённой.


# ---------- PUSH-УВЕДОМЛЕНИЯ НА ТЕЛЕФОН (Web Push) ----------
# Работают «из коробки»: если ключи не заданы, сервер сгенерирует их сам
# при первом запуске и сохранит в БД (коллекция pushconfig).
#
# ВАЖНО: ключи должны быть ПОСТОЯННЫМИ. Если их поменять — все подписки
# игроков станут недействительными, и уведомления перестанут приходить.
# Задавать здесь имеет смысл, только если хочешь хранить их в .env,
# а не в БД (например, при переезде базы).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Контакт для push-сервисов (Google/Mozilla) на случай проблем с рассылкой.
# PUSH_CONTACT=mailto:admin@yourdomain.com
