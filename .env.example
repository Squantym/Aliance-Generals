# ===================================================================
# .env.example — скопируйте в .env и заполните перед запуском
# Файл .env НЕЛЬЗЯ публиковать на GitHub (добавьте в .gitignore)!
# ===================================================================

# --- Порт сервера (по умолчанию 3000) ---
# PORT=3000

# --- База данных ---
#
# Игра работает на СОБСТВЕННОЙ базе SQLite на этом же сервере. Облачной
# MongoDB в проекте нет: инструкция по подключению Atlas была удалена
# намеренно. Причина не только техническая — данные игроков из России
# по закону должны первично записываться и храниться в российской базе,
# а зарубежное облако этому не отвечает. Если MONGODB_URI останется в
# окружении, сервер предупредит и всё равно её проигнорирует.
#
# DB_DRIVER=sqlite
# SQLITE_DIR=./data
# SQLITE_FILE=generals.db

# --- Отправка писем (подтверждение почты, восстановление пароля) ---
#
# Сервис российский, и это принципиально: письма с зарубежных серверов
# mail.ru и Яндекс кладут в спам заметно охотнее, а почта у нашей
# аудитории в основном там.
#
# SMTP.BZ — бесплатный тариф бессрочный (по их условиям 15 000 писем в
# месяц, до 500 в сутки).
#   1. Зарегистрируйтесь на smtp.bz
#   2. Добавьте домен и подтвердите его: сервис выдаст записи SPF, DKIM и
#      CNAME, пропишите их у регистратора. БЕЗ ЭТОГО письма падают в спам.
#      Проверить: node tools/check-dns.js ваш-домен.ru
#   3. В карточке домена включите «Транзакции» — игра шлёт письма через
#      транзакционный API, с выключенным переключателем они не уйдут.
#   4. Создайте ключ API и вставьте сюда.
# SMTPBZ_API_KEY=ваш_ключ
#
# Сервис ОДИН — он же единственная точка отказа: кончится тариф или
# случится сбой, и регистрация встанет целиком. Код к этому готов:
# отправка устроена цепочкой (CHAIN в src/services/email.ts), второй
# сервис добавляется одной строкой.
#
# Адрес API. Менять нужно только если сервис сменит точку входа.
# SMTPBZ_URL=https://api.smtp.bz/v1/smtp/send
#
# Отправитель. Адрес обязан быть на подтверждённом домене.
# EMAIL_FROM=Aliance Generals <noreply@aliance-general.ru>
#
# Адрес игры — из него собираются ссылки в письмах
# APP_URL=https://aliance-general.ru
#
# --- Лимиты писем (защита от выхода за тариф) ---
#
# Игра считает отправленные письма сама и останавливается ЗАРАНЕЕ.
# Иначе тариф кончился бы молча, и первым перестало бы работать не
# что-нибудь, а подтверждение почты у новых игроков.
# Значения по умолчанию соответствуют бесплатному тарифу SMTP.BZ.
# MAIL_LIMIT_MONTH=15000
# MAIL_LIMIT_DAY=500
#
# Неприкосновенный запас: столько писем месячного лимита рассылке
# недоступны. Они держатся на подтверждения почты и восстановление
# паролей — то, без чего игрок не может пользоваться аккаунтом.
# MAIL_RESERVE=300
#
# Если ключа нет — режим разработки: письма не отправляются, код и
# ссылка выводятся в консоль, почта считается подтверждённой.


# ---------- PUSH-УВЕДОМЛЕНИЯ НА ТЕЛЕФОН (Web Push) ----------
# Работают «из коробки»: если ключи не заданы, сервер сгенерирует их сам
# при первом запуске и сохранит в БД (коллекция pushconfig).
#
# ВАЖНО: ключи должны быть ПОСТОЯННЫМИ. Если их поменять — все подписки
# игроков станут недействительными, и уведомления перестанут приходить.
# Задавать здесь имеет смысл, только если хочешь хранить их в .env,
# а не в БД (например, при переезде базы).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Контакт для push-сервисов (Google/Mozilla) на случай проблем с рассылкой.
# PUSH_CONTACT=mailto:admin@yourdomain.com

# --- Служебный доступ ---
#
# Второй фактор входа обязателен для сотрудников: без него панель
# управления не открывается. Запрет стоит на входе в ПАНЕЛЬ, а не в
# игру, — сотрудник с севшим телефоном играет как все, а служебный
# доступ включается после настройки второго фактора.
# Выключать только для разбора аварии, и ненадолго.
# STAFF_2FA_REQUIRED=1

# --- Резервные копии ---
#
# Ключ шифрования копии, вывозимой за пределы сервера. Политика обработки
# персональных данных обещает, что незашифрованная копия наружу не
# уходит. Без этого файла tools/backup-offsite.sh отправит копию ОТКРЫТОЙ
# и лишь напечатает предупреждение — а в копии почта и хеши паролей всех
# игроков. Задайте путь до запуска вывоза.
# BACKUP_KEY_FILE=/root/.backup-key
